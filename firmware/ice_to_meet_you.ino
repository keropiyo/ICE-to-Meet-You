#include <Arduino.h>

HardwareSerial MidiSerial(1);

const int MIDI_TX_PIN = 4;   // Unit Synth RX
const int MOTOR_PIN   = 5;   // 1kΩ -> 2SC1815 base
const byte MIDI_CHANNEL = 0;
const byte MUSIC_BOX_PROGRAM = 10;
const byte REVERB_LEVEL = 120;
const byte VOLUME_LEVEL = 120;  // MIDI channel volume (0-127)

// Motor PWM settings
const int MOTOR_PWM_FREQ = 5000;
const int MOTOR_PWM_RES  = 8;      // 0-255
const int MOTOR_SPEED    = 200;    // 通常回転：小さいほどゆっくり
const int MOTOR_BOOST    = 220;    // 始動時だけ少し強く
const int BOOST_TIME_MS  = 250;    // 始動ブースト時間

struct MidiEvent {
  uint16_t waitMs;
  uint8_t note;
  uint8_t velocity;
  uint8_t noteOn;
};

void send3(byte status, byte data1, byte data2) {
  MidiSerial.write(status);
  MidiSerial.write(data1);
  MidiSerial.write(data2);
}

void programChange(byte channel, byte program) {
  MidiSerial.write(0xC0 | (channel & 0x0F));
  MidiSerial.write(program);
}

void controlChange(byte channel, byte control, byte value) {
  send3(0xB0 | (channel & 0x0F), control, value);
}

void noteOn(byte note, byte velocity) {
  send3(0x90 | MIDI_CHANNEL, note, velocity);
}

void noteOff(byte note) {
  send3(0x80 | MIDI_CHANNEL, note, 0);
}

